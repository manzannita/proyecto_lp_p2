# Copiar a .env y completar. El archivo .env esta en .gitignore: NUNCA se sube.

# Ruta al archivo SQLite en desarrollo.
# En produccion se reemplaza por la URL de PostgreSQL.
DATABASE_URL=noticia_ec.db

# Clave que los clientes deben mandar en el header X-API-Key.
# Generar una propia, por ejemplo:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# --- Asistente de IA (issue #3) ---
# Clave del proveedor LLM. Jamas escribirla en el codigo.
LLM_API_KEY=
LLM_MODELO=
